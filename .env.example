# Nunca coloque o token real neste arquivo versionado.
META_ACCESS_TOKEN=cole_o_novo_token_no_ambiente_da_hospedagem

# Opcional: use durante a validação no Gerenciador de Eventos da Meta.
META_TEST_EVENT_CODE=

# Opcional: altere somente quando a versão da Graph API for atualizada.
META_GRAPH_API_VERSION=v24.0
